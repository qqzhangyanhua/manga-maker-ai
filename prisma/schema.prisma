// ============================================================
// Novel Writing Module - AI 小说创作模块
// ============================================================

// 小说项目
model NovelProject {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String  @db.Uuid
  title       String  @db.VarChar(200)
  description String? @db.Text
  genre       String? @db.VarChar(50) // suspense, romance, adventure, scifi, fantasy, other

  // 世界观设定（JSON 结构化存储）
  world_setting Json? // { locations: [], factions: [], rules: [], timeline: [] }

  // 角色设定（JSON 结构化存储）
  characters Json? // [{ name, role, description, traits, relationships }]

  // 章节大纲（JSON 结构化存储）
  outlines Json? // [{ chapterNumber, title, outline, keyEvents, characters, plotLines, isKeyChapter }]

  // 项目配置
  target_words Int? // 目标字数
  status       String  @default("draft") // draft, writing, completed, archived
  cover_image  String? // AI生成的封面图URL

  // 统计信息
  total_words   Int @default(0)
  chapter_count Int @default(0)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  chapters NovelChapter[]
  prompts  NovelPromptTemplate[]

  @@index([user_id, status], map: "idx_novel_projects_user_status")
  @@index([user_id, updated_at], map: "idx_novel_projects_user_time")
  @@map("novel_projects")
}

// 小说章节
model NovelChapter {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id     String @db.Uuid
  chapter_number Int // 章节序号
  title          String @db.VarChar(200)

  // 章节大纲
  outline String? @db.Text // 章节大纲摘要（用于 RAG 检索）

  // 剧情连贯性字段（Solution 2 & 3）
  summary_preview String? @db.Text // 详细剧情预演（200-300字，用于上下文构建）
  ending_state    Json?   @db.JsonB // 章节结束状态 {location, protagonist_status, plot_progress}

  // 章节内容
  content    String? @db.Text // 完整章节内容（2000-5000字）
  word_count Int     @default(0)

  // AI 生成相关
  prompt_used String? @db.Text // 使用的 Prompt
  model_used  String? @db.VarChar(100) // 使用的模型

  // 状态
  status         String  @default("draft") // draft, writing, completed
  is_key_chapter Boolean @default(false) // 是否为关键章节（用于 RAG 优先检索）

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  project  NovelProject          @relation(fields: [project_id], references: [id], onDelete: Cascade)
  versions NovelChapterVersion[]

  @@unique([project_id, chapter_number], map: "unique_novel_chapter_number")
  @@index([project_id, chapter_number], map: "idx_novel_chapters_project_order")
  @@index([project_id, is_key_chapter], map: "idx_novel_chapters_key")
  @@map("novel_chapters")
}

// 章节版本（多版本对比）
model NovelChapterVersion {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chapter_id     String @db.Uuid
  version_number Int // 版本号（自增）
  content        String @db.Text
  word_count     Int    @default(0)

  // 生成参数
  prompt_used String? @db.Text
  model_used  String? @db.VarChar(100)
  temperature Float?  @default(0.7)

  // 版本状态
  is_selected Boolean @default(false) // 是否为当前选中版本
  user_rating Int? // 用户评分 1-5
  notes       String? @db.Text // 版本备注

  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  chapter       NovelChapter  @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  quality_score QualityScore?

  @@unique([chapter_id, version_number], map: "unique_chapter_version")
  @@index([chapter_id, is_selected], map: "idx_chapter_versions_selected")
  @@map("novel_chapter_versions")
}

// 章节质量评分（AI 评估）
model QualityScore {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version_id String @unique @db.Uuid

  // 总体评分（1-100）
  overall_score Int @db.SmallInt

  // 多维度评分（JSON 存储）
  // {
  //   readability: { score: 85, details: "流畅度高，语句通顺" },
  //   emotional_depth: { score: 75, details: "情感描写丰富" },
  //   pacing: { score: 80, details: "节奏把控得当" },
  //   originality: { score: 70, details: "有一定创新性" },
  //   coherence: { score: 90, details: "逻辑连贯性强" }
  // }
  dimensions Json

  // AI 改进建议（JSON 数组）
  // [
  //   { dimension: "emotional_depth", suggestion: "可以增加人物内心独白", priority: "high" },
  //   { dimension: "pacing", suggestion: "前半部分可以加快节奏", priority: "medium" }
  // ]
  suggestions Json?

  // 元数据
  analyzed_at      DateTime @default(now()) @db.Timestamptz(6)
  analyzer_version String   @default("1.0") // 评分算法版本（用于追踪模型变化）

  // Relations
  version NovelChapterVersion @relation(fields: [version_id], references: [id], onDelete: Cascade)

  @@map("quality_scores")
}

// Prompt 模板库
model NovelPromptTemplate {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id String? @db.Uuid // null = 全局模板
  user_id    String? @db.Uuid // null = 系统模板

  name     String @db.VarChar(100)
