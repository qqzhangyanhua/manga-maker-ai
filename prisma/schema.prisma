  variables Json // [{ name: "character_name", type: "string", required: true }]

  // 模板配置
  is_public Boolean @default(false)
  is_system Boolean @default(false)

  // 统计
  usage_count Int @default(0)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  project NovelProject? @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([category, is_public], map: "idx_novel_prompts_category")
  @@index([user_id], map: "idx_novel_prompts_user")
  @@index([project_id], map: "idx_novel_prompts_project")
  @@map("novel_prompt_templates")
}

model MaintenanceLog {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id   String  @db.Uuid
  operation String  @db.VarChar(50)
  status    String  @db.VarChar(20)
  details   Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, created_at], map: "idx_maintenance_logs_user_time")
  @@index([operation], map: "idx_maintenance_logs_operation")
  @@map("maintenance_logs")
}

// 用户小说配额（成本控制）
model NovelQuota {
  user_id           String   @id @db.Uuid
  daily_limit       Int      @default(50) // 每日生成次数限制
  used_today        Int      @default(0)
  tokens_used_total Int      @default(0)
  reset_at          DateTime
  custom_api_key    String?  @db.Text // 用户自定义 API Key（加密存储）

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("novel_quotas")
}

// 九宫格图片记录
model NineGridImage {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String   @db.Uuid
  chapter_id        String   @db.Uuid
  panel_ids         String[] // 9个分镜ID
  image_url         String   // MinIO URL
  prompt_combined   String   @db.Text // 组合后的提示词
  comic_style_id    String?  @db.Uuid
  reference_image   String?
  
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id], map: "idx_nine_grid_images_user")
  @@index([chapter_id], map: "idx_nine_grid_images_chapter")
  @@map("nine_grid_images")
}

// ============ Infinite Canvas System ============

// 无限画布时间线项目
model CanvasTimeline {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  novel_project_id   String   @db.Uuid
  user_id            String   @db.Uuid
  title              String
  status             String   @default("draft") // draft, generating, completed, error

  // 配置
  config             Json     @default("{\"auto_generate\":true,\"use_character_library\":true,\"use_scene_library\":true}")

  // 统计
  total_chapters     Int      @default(0)
  completed_chapters Int      @default(0)
  total_shots        Int      @default(0)
  total_images       Int      @default(0)

  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  chapters           TimelineChapter[]

  @@index([user_id], map: "idx_canvas_timeline_user")
  @@index([novel_project_id], map: "idx_canvas_timeline_project")
  @@map("canvas_timelines")
}

// 时间线章节节点
model TimelineChapter {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timeline_id    String   @db.Uuid
  chapter_id     String   @db.Uuid
  chapter_number Int

  // 生成状态（每个阶段独立追踪）
  script_status  String   @default("pending") // pending, generating, completed, error
  shot_status    String   @default("pending")
  scene_status   String   @default("pending")
  final_status   String   @default("pending")

  // 角色绑定（本章节出现的角色ID列表）
  character_ids  String[] @default([]) @db.Uuid

  // 风格选择
  comic_style_id String?  @db.Uuid // FK to ComicStyle

  // 统计
  script_segment_count Int @default(0)
  shot_count           Int @default(0)
  scene_image_count    Int @default(0)
  final_image_count    Int @default(0)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  timeline        CanvasTimeline    @relation(fields: [timeline_id], references: [id], onDelete: Cascade)
  comic_style     ComicStyle?       @relation(fields: [comic_style_id], references: [id], onDelete: SetNull)
  script_segments ScriptSegment[]

  @@index([timeline_id], map: "idx_timeline_chapter_timeline")
  @@index([chapter_id], map: "idx_timeline_chapter_chapter")
  @@index([comic_style_id], map: "idx_timeline_chapter_style")
  @@map("timeline_chapters")
}

// 剧本片段
model ScriptSegment {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timeline_chapter_id String   @db.Uuid
  segment_order       Int

  // 剧本内容
  content             String   @db.Text
  scene_description   String   @db.Text
  character_actions   String   @db.Text
  dialogue            String?  @db.Text

  // 元数据
  estimated_duration  Int      @default(0) // 秒
  emotion_tone        String   @default("")

  // 原始小说文本关联
  source_text_start   Int      @default(0)
  source_text_end     Int      @default(0)

  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  timeline_chapter TimelineChapter @relation(fields: [timeline_chapter_id], references: [id], onDelete: Cascade)
  shot_designs     ShotDesign[]

  @@index([timeline_chapter_id], map: "idx_script_segment_chapter")
  @@map("script_segments")
}

// 镜头设计
model ShotDesign {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  script_segment_id String   @db.Uuid
  shot_order        Int

  // 镜头参数
  camera_angle      String   @default("")
  shot_size         String   @default("")
  panel_type        String   @default("")

  // 内容描述
  shot_description  String   @db.Text
  composition_hint  String   @db.Text

  // 场景位置标识 - 用于场景去重
  location_key      String   @default("") // e.g., "classroom", "hallway", "rooftop"

  // 资产绑定
  character_ids     String[] @default([])
  scene_id          String?  @db.Uuid
  expression_types  String[] @default([])
  outfit_ids        String[] @default([])

  // 共享场景图引用 (多个镜头可共享同一场景图)
  shared_scene_id   String?  @db.Uuid

  // 生成提示词
  prompt            String   @db.Text
  negative_prompt   String?  @db.Text
  generated_image_url String?
  generation_status   String   @default("pending")

  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  script_segment ScriptSegment  @relation(fields: [script_segment_id], references: [id], onDelete: Cascade)
  scene_images   SceneImage[]   @relation("ShotToSceneImages") // 1:N legacy relation
  shared_scene   SceneImage?    @relation("SharedScene", fields: [shared_scene_id], references: [id], onDelete: SetNull)
  comic_panels   ComicPanelResult[]

  @@index([script_segment_id], map: "idx_shot_design_segment")
  @@index([location_key], map: "idx_shot_design_location")
  @@map("shot_designs")
}

// 场景基础图
model SceneImage {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shot_design_id     String   @db.Uuid

  // 场景位置标识 - 用于去重分组
  location_key       String   @default("")

  // 图像信息
  image_url          String
  width              Int      @default(1024)
  height             Int      @default(768)

  // 生成参数
  generation_prompt  String   @db.Text
  scene_id           String?  @db.Uuid

  // AI 生成元数据
  model_used         String   @default("")
  seed               Int?
  generation_params  Json     @default("{}")

  status             String   @default("generating") // generating, completed, failed
  error_message      String?  @db.Text

  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  shot_design   ShotDesign         @relation("ShotToSceneImages", fields: [shot_design_id], references: [id], onDelete: Cascade)
  shared_shots  ShotDesign[]       @relation("SharedScene") // 共享此场景的镜头列表
  comic_panels  ComicPanelResult[]

  @@index([shot_design_id], map: "idx_scene_image_shot")
  @@index([location_key], map: "idx_scene_image_location")
  @@map("scene_images")
}

// 最终漫画图
model ComicPanelResult {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shot_design_id             String   @db.Uuid
  scene_image_id             String   @db.Uuid

  // 最终图像
  image_url                  String
  width                      Int      @default(1024)
  height                     Int      @default(768)

  // 生成参数
  generation_prompt          String   @db.Text
  character_reference_images String[] @default([])

  // 垫图参数
  controlnet_type            String   @default("reference")
  controlnet_weight          Float    @default(0.7)

  // AI 生成元数据
  model_used                 String   @default("")
  lora_models                String[] @default([])
  generation_params          Json     @default("{}")

  status                     String   @default("generating") // generating, completed, failed
  error_message              String?  @db.Text
  exported_to_panel_id       String?  @db.Uuid

  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  shot_design  ShotDesign @relation(fields: [shot_design_id], references: [id], onDelete: Cascade)
  scene_image  SceneImage @relation(fields: [scene_image_id], references: [id], onDelete: Cascade)

  @@index([shot_design_id], map: "idx_comic_panel_shot")
  @@index([scene_image_id], map: "idx_comic_panel_scene")
  @@map("comic_panel_results")
}

// ============================================================
// P1 功能增强 - 状态持久化与分析缓存
// ============================================================

// 渐进式生成会话（解决用户刷新丢失问题）
model ProgressiveSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  project_id String?  @db.Uuid // 关联的项目 ID（可选）

  // 会话状态
  step       Int      // 当前步骤 (1-10)
  state      Json     @db.JsonB // 会话状态数据（包含所有中间结果）

  // 元数据
  session_type String @default("outline") // outline, character, world_setting

  // 生命周期
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  expires_at DateTime  @db.Timestamptz(6) // 过期时间（24小时后）

  @@index([user_id, expires_at], map: "idx_progressive_sessions_user_expires")
  @@index([project_id], map: "idx_progressive_sessions_project")
  @@map("progressive_sessions")
}

// 智能分析结果缓存（避免重复生成，节省 API 成本）
model AnalysisReport {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id String   @db.Uuid
  user_id    String   @db.Uuid

  // 分析类型
  analysis_type String @db.VarChar(50) // cool_points, pacing, opening_hook, comprehensive, character_analysis, world_setting_analysis

  // 分析结果（JSON 存储）
  result     Json     @db.JsonB // 分析结果的完整数据

  // 输入内容哈希（用于检测是否需要重新生成）
  input_hash String   @db.VarChar(64) // SHA256 hash of input content

  // 元数据
  model_used String?  @db.VarChar(100) // 使用的模型
  tokens_used Int?    // 消耗的 tokens 数
  cost_usd   Float?   // 成本（美元）

  // 生命周期
  created_at DateTime @default(now()) @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6) // 缓存过期时间（7天后）

  @@index([project_id, analysis_type], map: "idx_analysis_reports_project_type")
  @@index([user_id, created_at], map: "idx_analysis_reports_user_time")
  @@index([input_hash, analysis_type], map: "idx_analysis_reports_hash_type")
  @@map("analysis_reports")
}
