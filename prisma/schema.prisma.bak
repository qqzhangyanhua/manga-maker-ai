generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique
  email_verified    DateTime? @db.Timestamptz(6)
  name              String?
  image             String?
  password          String?
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)
  verified          Boolean?  @default(false)
  email_verified_at DateTime? @db.Timestamptz(6)
  password_hash     String?   @default("")
  role              String?   @default("user")
  status            String?   @default("active")

  // Credits system
  credits            Int @default(2000) // 褰撳墠绠楀姏浣欓
  total_credits_used Int @default(0)    // 绱娑堣€楃畻鍔?

  // Phase 1 relations
  panelTemplates       PanelTemplate[]
  templateLikes        TemplateLike[]
  generationTasks      GenerationTask[]
  tags                 Tag[]
  creditTransactions   CreditTransaction[]

  @@map("users")
}

model EmailVerification {
  id         Int      @id @default(autoincrement())
  email      String
  code_hash  String
  expires_at DateTime @db.Timestamptz(6)
  used       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([email], map: "idx_email_verifications_email")
  @@map("email_verifications")
}

model LlmProvider {
  id            Int      @id @default(autoincrement())
  provider_type String
  provider_name String   @default("openai")
  model         String
  base_url      String
  api_key       String   @default("")
  priority      Int      @default(1)
  enabled       Boolean  @default(true)
  desc          String?  // 鎻忚堪杩欎釜閰嶇疆鏄敤鏉ュ共鍢涚殑
  credits_cost  Int      @default(0) // 姣忔璋冪敤娑堣€楃殑绠楀姏锛?=涓嶆秷鑰?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([provider_type, enabled, priority], map: "idx_llm_providers_type_enabled")
  @@map("llm_providers")
}

// Character Management - "Digital Actor" System
model Character {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String   @db.Uuid
  name              String
  description       String?
  base_prompt       String   @default("")
  tags              String[] @default([])
  base_image_url    String?
  lora_model_url    String?
  lora_trigger_word String?
  training_status   String   @default("pending") // pending, training, ready, failed
  training_progress Int      @default(0)
  usage_count       Int      @default(0)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)

  // Phase 2: New fields for consistency
  reference_image String? // Main reference image URL for IP-Adapter
  style_prompt    String? @db.Text // Detailed style description for prompt

  // Phase 3: Comic Style relation
  comic_style_id String? @db.Uuid // FK to ComicStyle

  views       CharacterView[]
  expressions CharacterExpression[]
  outfits     CharacterOutfit[]

  // Phase 2: New relations
  story_characters      StoryCharacter[]
  panels                Panel[]
  chapter_character_states ChapterCharacterState[] // Phase 4: Character state tracking
  comic_style           ComicStyle? @relation(fields: [comic_style_id], references: [id], onDelete: SetNull)

  @@index([user_id, training_status], map: "idx_characters_user_status")
  @@index([comic_style_id], map: "idx_characters_comic_style")
  @@map("characters")
}

// Three-view reference images (front, side, back)
model CharacterView {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  character_id String   @db.Uuid
  view_type    String // front, side, back
  image_url    String
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  character Character @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@unique([character_id, view_type], map: "unique_character_view")
  @@map("character_views")
}

// Expression matrix for emotional consistency
model CharacterExpression {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  character_id    String   @db.Uuid
  expression_type String // neutral, happy, sad, angry, surprised, shy, confident, worried, determined
  image_url       String
  prompt_suffix   String? // Additional prompt for this expression
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  character Character @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@unique([character_id, expression_type], map: "unique_character_expression")
  @@map("character_expressions")
}

// Wardrobe system - multiple outfits per character
model CharacterOutfit {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  character_id    String   @db.Uuid
  outfit_name     String
  outfit_type     String // default, school, battle, casual, formal, sleepwear, custom
  image_url       String?
  prompt_modifier String   @default("") // Outfit-specific prompt additions
  trigger_word    String? // Optional trigger word for this outfit
  is_default      Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  character Character @relation(fields: [character_id], references: [id], onDelete: Cascade)

  // Phase 2: Reverse relation
  panels Panel[]

  @@index([character_id, is_default], map: "idx_outfits_character_default")
  @@map("character_outfits")
}

// Project/Work management
model Project {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  story_id    String?  @db.Uuid // Link to Story (optional)
  title       String
  description String?
  style       String?
  status      String   @default("draft") // draft, in_progress, completed
  cover_image String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  panels          Panel[]
  script          StoryScript?
  Story           Story?            @relation(fields: [story_id], references: [id])
  versions        ProjectVersion[] // Phase 1: Version control
  generationTasks GenerationTask[] // Phase 1: Batch generation

  @@index([user_id, status], map: "idx_projects_user_status")
  @@index([story_id], map: "idx_projects_story")
  @@map("projects")
}

// Individual comic panels
model Panel {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id      String  @db.Uuid
  panel_order     Int
  panel_type      String // wide, medium, closeup, action, dialogue, transition
  importance      String // high, medium, low
  description     String
  dialogue        String?
  character_name  String? // DEPRECATED: Use character_id instead
  emotion         String?
  generated_image String?
  prompt_used     String?

  // New fields for script editor
  script_segment_id String? // Link to script segment
  script_start      Int? // Text start position
  script_end        Int? // Text end position
  camera_angle      String? // 淇/浠拌/骞宠/鑽峰叞瑙?
  shot_size         String? // 鐗瑰啓/杩戞櫙/涓櫙/鍏ㄦ櫙/杩滄櫙

  // Camera movement parameters
  camera_movement   String? // static | push_in | pull_out | pan_left | pan_right | tilt_up | tilt_down | dolly | zoom
  movement_speed    String? // slow | medium | fast | sudden
  movement_direction String? // 琛ュ厖鎻忚堪锛堝锛歞iagonal_up_right锛?

  sketch_image_url  String? // Sketch preview URL
  visual_prompt     String? // Editable visual description

  // Phase 2: Asset binding fields
  character_id    String? @db.Uuid // FK to Character
  expression_type String? // neutral, happy, sad, angry, surprised, shy, confident, worried, determined
  outfit_id       String? @db.Uuid // FK to CharacterOutfit
  scene_id        String? @db.Uuid // FK to Scene

  // Chapter grouping (optional, for story-based projects)
  chapter_id String? @db.Uuid // FK to Chapter

  // Phase 3: Layout grouping for multi-panel layouts (2闀?4闀?6闀?
  // null = independent panel (1闀?
  // "group_start_2" = start of 2-panel layout group
  // "group_start_4" = start of 4-panel layout group
  // "group_start_6" = start of 6-panel layout group
  // "group_member" = belongs to previous group
  layout_hint String?

  // Gallery sharing fields
  is_shared   Boolean   @default(false) // 鏄惁鍒嗕韩鍒扮敾寤?
  shared_at   DateTime? @db.Timestamptz(6) // 鍒嗕韩鏃堕棿
  view_count  Int       @default(0) // 娴忚娆℃暟
  show_prompt Boolean   @default(true) // 鏄惁鍏紑 prompt

  created_at DateTime @default(now()) @db.Timestamptz(6)

  project  Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  variants PanelVariant[] // Phase 1: Variant generation

  // Phase 2: Asset relations
  character Character?      @relation(fields: [character_id], references: [id], onDelete: SetNull)
  outfit    CharacterOutfit? @relation(fields: [outfit_id], references: [id], onDelete: SetNull)
  scene     Scene?          @relation(fields: [scene_id], references: [id], onDelete: SetNull)
  chapter   Chapter?        @relation(fields: [chapter_id], references: [id], onDelete: SetNull)

  @@index([project_id, panel_order], map: "idx_panels_project_order")
  @@index([character_id], map: "idx_panels_character")
  @@index([scene_id], map: "idx_panels_scene")
  @@index([outfit_id], map: "idx_panels_outfit")
  @@index([chapter_id], map: "idx_panels_chapter")
  @@index([is_shared, shared_at], map: "idx_panels_shared")
  @@map("panels")
}

// Story Script - Store original script and segmentation info for script editor
model StoryScript {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id String   @unique @db.Uuid
  content    String   @db.Text // Full original script text
  segments   Json // [{ id, text, start, end, panel_id }]
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("story_scripts")
}

// Generated images gallery
model GeneratedImage {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String   @db.Uuid
  image_url         String
  prompt            String
  style             String?
  source_type       String? // panel | character | pose | scene | other
  source_id         String? @db.Uuid
  character_id      String?  @db.Uuid
  generation_params Json? // Store model, steps, cfg, etc.
  
  // For serialized comic/manga generation tracking
  chapter_id        String? @db.Uuid // FK to Chapter (for multi-panel/serialized images)
  panel_ids         String[] // Array of panel IDs (for multi-panel images)
  
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, created_at], map: "idx_generated_images_user_time")
  @@index([chapter_id], map: "idx_generated_images_chapter")
  @@map("generated_images")
}

// Character Relationship Chart - for managing character positions and relationships
model CharacterRelationship {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  character_id String   @db.Uuid
  position_x   Float    @default(0)
  position_y   Float    @default(0)
  scale        Float    @default(1.0)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, character_id], map: "unique_user_character_relationship")
  @@index([user_id], map: "idx_relationships_user")
  @@map("character_relationships")
}

// Comic Styles - Configurable comic style library
model ComicStyle {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  style_key     String   @unique // manga, american, webtoon, etc.
  name_zh       String // 鏃ュ紡婕敾
  name_en       String // MANGA
  image_url     String // Preview image URL
  tag_color     String   @default("bg-primary text-background") // Tailwind classes
  description   String? // Optional description
  prompt_prefix String?  @default("") // AI prompt prefix for this style
  sort_order    Int      @default(0) // Display order (lower = first)
  enabled       Boolean  @default(true) // Soft delete flag
  usage_count   Int      @default(0) // Usage statistics
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  // Phase 3: Reverse relation for characters using this style
  characters Character[]

  // Reverse relation for stories using this style
  stories    Story[]

  @@index([enabled, sort_order], map: "idx_comic_styles_enabled_sort")
  @@map("comic_styles")
}

model GenerationLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String   @db.Uuid
  project_id       String?  @db.Uuid
  action           String
  provider_type    String?
  status           String // success | failed
  duration_ms      Int?
  request_payload  Json?
  response_payload Json?
  error_message    String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, action, created_at], map: "idx_generation_logs_user_action_time")
  @@map("generation_logs")
}

model ImagePageVersion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  project_id String?  @db.Uuid
  label      String
  source_type String
  status     String   @default("completed")
  image_url  String?
  task_id    String?
  metadata   Json?
  canvas_schema Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, created_at], map: "idx_image_page_versions_user")
  @@index([task_id], map: "idx_image_page_versions_task")
  @@map("image_page_versions")
}

model UsageStat {
  id            Int      @id @default(autoincrement())
  user_id       String   @db.Uuid
  action        String
  provider_type String?
  date          DateTime @db.Date
  count         Int      @default(0)
  last_used_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, action, date], map: "unique_usage_per_day")
  @@index([user_id, action], map: "idx_usage_user_action")
  @@map("usage_stats")
}

// Scene Library - Background/Environment assets for manga panels
model Scene {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  name        String
  description String?
  scene_type  String // indoor, outdoor, urban, nature, fantasy, scifi, historical, abstract
  image_url   String?
  tags        String[] @default([])
  prompt      String?  @db.Text // AI prompt used to generate/describe the scene
  lighting_preset String? // golden_hour | harsh_midday | soft_diffused | dramatic_rim | neon_night | moonlight | studio | natural_window | none
  usage_count Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  // Phase 2: Reverse relation
  panels Panel[]

  @@index([user_id, scene_type], map: "idx_scenes_user_type")
  @@map("scenes")
}

// Story Template - Predefined story structures and templates
model StoryTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String // Template name (e.g., "涓夊箷鍓х粨鏋?, "鑻遍泟涔嬫梾")
  category    String // suspense/romance/adventure/scifi/daily/fantasy
  description String?  @db.Text
  structure   Json // Story structure: { acts: [...], plot_points: [...] }
  prompts     Json // Prompt templates for generation
  is_public   Boolean  @default(true)
  user_id     String?  @db.Uuid // null = system template
  usage_count Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([category, is_public], map: "idx_story_templates_category")
  @@map("story_templates")
}

// Story - Story outline and character setup
model Story {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @db.Uuid
  title           String
  premise         String   @db.Text // Story premise/idea
  genre           String // Genre: suspense/romance/adventure/scifi/daily/fantasy
  outline         Json // Story outline: { acts: [...], scenes: [...] }
  characters      Json? // DEPRECATED: Use story_characters relation instead
  template_id     String?  @db.Uuid
  comic_style_id  String?  @db.Uuid // FK to ComicStyle for visual style
  style_reference_image String? // Reference image URL for extracting visual style (highest priority)
  suggested_characters Json? // AI鍒嗘瀽鐨勫缓璁鑹插垪琛紙绗竴姝ュ垎鏋愮粨鏋滐級
  status          String   @default("draft") // draft/completed
  is_sample       Boolean  @default(false) // Sample project for new users
  sample_category String?  // beginner/intermediate/advanced

  // 杩炶浇妯″紡鏀寔
  is_serialized   Boolean  @default(true) // 鏄惁涓鸿繛杞戒綔鍝侊紙榛樿鍚敤锛?
  serial_status   String?  @default("ongoing") // ongoing/completed/hiatus - 杩炶浇鐘舵€?

  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  projects Project[] // One story can generate multiple projects
  chapters Chapter[] // Story chapters

  // Phase 2: Real character relationship
  story_characters StoryCharacter[]

  // Comic style relationship
  comic_style ComicStyle? @relation(fields: [comic_style_id], references: [id], onDelete: SetNull)

  @@index([user_id, status], map: "idx_stories_user_status")
  @@index([is_sample], map: "idx_stories_sample")
  @@index([comic_style_id], map: "idx_stories_comic_style")
  @@index([is_serialized, serial_status], map: "idx_stories_serialized")
  @@map("stories")
}

// Chapter - Story chapters for structured storytelling
model Chapter {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  story_id      String   @db.Uuid
  title         String // Chapter title (e.g., "绗竴绔狅細鐩搁亣")
  summary       String?  @db.Text // Chapter summary for AI panel generation
  chapter_order Int // Display order in story

  // Phase 4: Enhanced chapter content for long-form storytelling
  content            String?  @db.Text // Detailed chapter content (2000-5000 words) for context
  is_key_chapter     Boolean  @default(false) // Mark as key chapter for context loading
  key_chapter_reason String?  @db.Text // Why this chapter is key (e.g., "character death", "major plot twist")

  // 杩炶浇妯″紡鏀寔
  publish_status String   @default("draft") // draft/published/archived - 绔犺妭鍙戝竷鐘舵€?
  published_at   DateTime? @db.Timestamptz(6) // 鍙戝竷鏃堕棿

  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  story             Story                   @relation(fields: [story_id], references: [id], onDelete: Cascade)
  panels            Panel[]
  character_states  ChapterCharacterState[] // Character states at end of chapter

  @@index([story_id, chapter_order], map: "idx_chapters_story_order")
  @@index([story_id, is_key_chapter], map: "idx_chapters_key")
  @@index([story_id, publish_status], map: "idx_chapters_publish_status")
  @@map("chapters")
}

// ============================================================
// Phase 2: Story-Character Relationship
// ============================================================

// StoryCharacter - Many-to-many relationship between Story and Character
model StoryCharacter {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  story_id      String   @db.Uuid
  character_id  String   @db.Uuid
  role          String   @default("supporting") // protagonist, antagonist, supporting, minor
  character_arc String?  @db.Text // Character development in this story
  display_order Int      @default(0) // Display order in UI
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  story     Story     @relation(fields: [story_id], references: [id], onDelete: Cascade)
  character Character @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@unique([story_id, character_id], map: "unique_story_character")
  @@index([story_id], map: "idx_story_characters_story")
  @@index([character_id], map: "idx_story_characters_character")
  @@map("story_characters")
}

// Workflow - Automation workflow tracking
model Workflow {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  story_id     String?   @db.Uuid
  project_id   String?   @db.Uuid
  type         String // auto_generate/manual/batch
  status       String // pending/running/completed/failed/cancelled
  current_step String? // story/script/storyboard/images/export
  progress     Int       @default(0) // 0-100
  config       Json // Workflow configuration
  result       Json? // Final result data
  error        String?   @db.Text
  started_at   DateTime?
  completed_at DateTime?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id, status], map: "idx_workflows_user_status")
  @@index([status, created_at], map: "idx_workflows_status_time")
  @@map("workflows")
}

// ============================================================
// Phase 1: New Models - Template, Batch Generation, Version Control, Tags
// ============================================================

// Panel Template - Reusable storyboard layouts
model PanelTemplate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String?  @db.Uuid // null = official template
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  panel_count  Int // Number of panels in this template
  template_data Json // Template structure: { panels: [{ panel_type, camera_angle, shot_size, importance, relative_position }] }
  tags         String[] @default([])
  is_public    Boolean  @default(false)
  is_official  Boolean  @default(false)
  likes_count  Int      @default(0)
  usage_count  Int      @default(0)
  thumbnail_url String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  user  User?          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  likes TemplateLike[]

  @@index([user_id], map: "idx_panel_templates_user")
  @@index([is_public, is_official], map: "idx_panel_templates_public")
  @@index([tags], map: "idx_panel_templates_tags")
  @@map("panel_templates")
}

// Template Likes - Track user likes for templates
model TemplateLike {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id String   @db.Uuid
  user_id     String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  template PanelTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([template_id, user_id], map: "unique_template_user_like")
  @@index([user_id], map: "idx_template_likes_user")
  @@map("template_likes")
}

// Generation Task - Track batch generation progress
model GenerationTask {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String    @db.Uuid
  project_id          String    @db.Uuid
  panel_ids           String[]  @db.Uuid // List of panel IDs to generate
  task_type           String // "batch" | "variant"
  status              String    @default("pending") // "pending" | "processing" | "completed" | "failed" | "cancelled"
  progress            Int       @default(0) // 0-100
  current_panel_index Int       @default(0)
  settings            Json // Generation settings: { style, quality, failureMode }
  error_logs          Json? // Error logs: [{ panelId, error, timestamp }]
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)
  completed_at        DateTime? @db.Timestamptz(6)

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_generation_tasks_user")
  @@index([project_id], map: "idx_generation_tasks_project")
  @@index([status], map: "idx_generation_tasks_status")
  @@map("generation_tasks")
}

// Panel Variant - Alternative versions of a panel
model PanelVariant {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  panel_id     String   @db.Uuid
  image_url    String
  prompt       String   @db.Text
  variant_type String // "original" | "composition" | "lighting" | "angle"
  is_selected  Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  panel Panel @relation(fields: [panel_id], references: [id], onDelete: Cascade)

  @@index([panel_id], map: "idx_panel_variants_panel")
  @@index([is_selected], map: "idx_panel_variants_selected")
  @@map("panel_variants")
}

// Project Version - Version control for projects
model ProjectVersion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id        String   @db.Uuid
  version_number    Int // Auto-increment version number
  label             String?  @db.VarChar(100) // User-defined label
  version_data      Json // Incremental snapshot: { project, panels, script }
  change_summary    String?  @db.Text // Auto-generated change summary
  is_auto           Boolean  @default(true) // Auto-save or manual
  is_pinned         Boolean  @default(false) // Prevent auto-deletion
  created_by_action String? // "batch_generate" | "apply_template" | "manual"
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, version_number], map: "unique_project_version")
  @@index([project_id, created_at], map: "idx_project_versions_time")
  @@map("project_versions")
}

// Tag - Universal tagging system
model Tag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(50)
  type        String   @default("user") // "system" | "user"
  category    String?  @db.VarChar(50) // "style" | "scene_type" | "character_type"
  created_by  String?  @db.Uuid // null = system tag
  usage_count Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  user     User?     @relation(fields: [created_by], references: [id], onDelete: SetNull)
  taggings Tagging[]

  @@index([type], map: "idx_tags_type")
  @@index([category], map: "idx_tags_category")
  @@map("tags")
}

// Tagging - Polymorphic tagging relationship
model Tagging {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tag_id        String   @db.Uuid
  taggable_type String // "Character" | "Scene" | "Project" | "Story" | "PanelTemplate"
  taggable_id   String   @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  tag Tag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@unique([tag_id, taggable_type, taggable_id], map: "unique_tagging")
  @@index([taggable_type, taggable_id], map: "idx_taggings_taggable")
  @@map("taggings")
}

// ============================================================
// Credit Transaction - 绠楀姏浜ゆ槗璁板綍
// ============================================================

model CreditTransaction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  amount      Int      // 姝ｆ暟=鍏呭€?璧犻€侊紝璐熸暟=娑堣€?
  balance     Int      // 鍙樺姩鍚庝綑棰?
  action      String   // register/consume/recharge/admin_adjust/refund
  description String?  // 鎻忚堪
  ref_type    String?  // 鍏宠仈绫诲瀷: generation_log/order/admin
  ref_id      String?  @db.Uuid // 鍏宠仈ID
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at], map: "idx_credit_transactions_user_time")
  @@index([action], map: "idx_credit_transactions_action")
  @@map("credit_transactions")
}

// ============================================================
// Phase 4: Chapter Character State Tracking
// ============================================================

// ChapterCharacterState - Track character state at the end of each chapter
model ChapterCharacterState {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chapter_id           String   @db.Uuid
  character_id         String   @db.Uuid
  location             String?  @db.Text // Character location at chapter end
  physical_condition   String?  @db.Text // Physical state (e.g., "injured right arm", "exhausted")
  mental_state         String?  @db.Text // Mental/emotional state
  key_items            String[] @default([]) // Key items character possesses
  relationship_changes Json?    // Changes in relationships: { characterId: "description" }
  notes                String?  @db.Text // Additional notes
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @db.Timestamptz(6)

  chapter   Chapter   @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  character Character @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@unique([chapter_id, character_id], map: "unique_chapter_character_state")
  @@index([chapter_id], map: "idx_chapter_character_states_chapter")
  @@index([character_id], map: "idx_chapter_character_states_character")
  @@map("chapter_character_states")
}


