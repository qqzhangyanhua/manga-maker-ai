# 数据库配置（与 Next.js 共享）
DATABASE_URL=postgresql://user:password@postgres:5432/manga

# JWT 配置（与 Next.js 共享）
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256

# OpenAI API 配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview

# Embedding 模型配置（用于 RAG 向量检索）
# 推荐: text-embedding-3-small (性价比最高, 62.5% 更便宜, 512 维)
# 备选: text-embedding-ada-002 (旧版, 1536 维)
# 高级: text-embedding-3-large (最强, 3072 维, 价格略高)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding API Base URL（可选）
# 如果不设置，则使用 OPENAI_API_BASE
# 适用场景：Chat 和 Embedding 使用不同的 API endpoint
# OPENAI_EMBEDDING_API_BASE=https://api.openai.com/v1

# MinIO 配置（与 Next.js 共享）
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=manga-assets
MINIO_USE_SSL=false

# 服务配置
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=INFO

# 向量数据库配置（RAG）
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=novel_chapters
RAG_TOP_K=3
RAG_ENABLE_VECTOR_SEARCH=true
