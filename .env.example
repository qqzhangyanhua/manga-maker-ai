# 数据库
DATABASE_URL=postgresql://manga:manga123@localhost:5432/manga
# DATABASE_SSL=true

# PostgreSQL（Docker Compose）
POSTGRES_USER=manga
POSTGRES_PASSWORD=manga123
POSTGRES_DB=manga
POSTGRES_PORT=5432

# JWT / Cookie 签名
AUTH_SECRET=请替换为足够复杂的随机字符串

# 初始管理员邮箱（仅在首次启动且无管理员时生效）
INITIAL_ADMIN_EMAIL=admin@example.com

# Redis（限流/队列）
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
NOVEL_BACKEND_URL=http://localhost:8000
# MinIO 对象存储
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=manga-assets
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# 邮件服务
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USER=your@qq.com
EMAIL_PASSWORD=your_smtp_key
EMAIL_FROM="ComicAI <your@qq.com>"

# 小说后端服务
NOVEL_SERVICE_URL=http://localhost:8000
NOVEL_BACKEND_PORT=8000
# 宿主机绑定地址。默认只监听本机回环，设为 0.0.0.0 可对局域网开放。
NOVEL_BACKEND_BIND=127.0.0.1

# OpenAI API（小说生成）
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview
