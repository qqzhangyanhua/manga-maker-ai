/**
 * Migrate Panel.character_name to Panel.character_id
 */
async function migratePanelCharacters(): Promise<void> {
  console.log("\n=== Migrating Panel Characters ===\n");

  const panels = await prisma.panel.findMany({
    where: {
      character_name: { not: null },
      character_id: null,
    },
    include: {
      project: true,
    },
  });

  console.log(`Found ${panels.length} panels with character_name but no character_id`);

  let linkedCount = 0;
  let skippedCount = 0;

  for (const panel of panels) {
    if (!panel.character_name) continue;

    // Try to find matching character
    const matchedCharacter = await prisma.character.findFirst({
      where: {
        user_id: panel.project.user_id,
        name: { contains: panel.character_name, mode: "insensitive" },
      },
    });

    if (matchedCharacter) {
      await prisma.panel.update({
        where: { id: panel.id },
        data: { character_id: matchedCharacter.id },
      });

      console.log(
        `  [LINKED] Panel ${panel.panel_order} "${panel.character_name}" -> "${matchedCharacter.name}"`
      );
      linkedCount++;
    } else {
      console.log(
        `  [NO MATCH] Panel ${panel.panel_order} "${panel.character_name}"`
      );
      skippedCount++;
    }
  }

  console.log(`\n  Summary: ${linkedCount} linked, ${skippedCount} skipped`);
}

/**
 * Copy Character.base_image_url to Character.reference_image
 */
async function migrateCharacterReferenceImages(): Promise<void> {
  console.log("\n=== Migrating Character Reference Images ===\n");

  const result = await prisma.$executeRaw`
    UPDATE characters
    SET reference_image = base_image_url
    WHERE base_image_url IS NOT NULL
      AND base_image_url != ''
      AND (reference_image IS NULL OR reference_image = '')
  `;

  console.log(`  Updated ${result} character reference images`);
}

/**
 * Print migration summary
 */
async function printSummary(): Promise<void> {
  console.log("\n=== Migration Summary ===\n");

  const storyCharacterCount = await prisma.storyCharacter.count();
  const panelsWithCharacter = await prisma.panel.count({
    where: { character_id: { not: null } },
  });
  const charactersWithRef = await prisma.character.count({
    where: { reference_image: { not: null } },
  });

  console.log(`  StoryCharacter records: ${storyCharacterCount}`);
  console.log(`  Panels with character_id: ${panelsWithCharacter}`);
  console.log(`  Characters with reference_image: ${charactersWithRef}`);
}

/**
 * Main migration function
 */
async function main(): Promise<void> {
  console.log("========================================");
  console.log("  Phase 2 Data Migration");
  console.log("========================================");

  try {
    // 1. Migrate story characters
    await migrateStoryCharacters();

    // 2. Migrate panel characters
    await migratePanelCharacters();

    // 3. Migrate character reference images
    await migrateCharacterReferenceImages();

    // 4. Print summary
    await printSummary();

    console.log("\n========================================");
    console.log("  Migration completed successfully!");
    console.log("========================================\n");
  } catch (error) {
    console.error("\nMigration failed:", error);
    process.exit(1);
  } finally {
    await prisma.$disconnect();
  }
}

// Run migration
main();
