/**
 * Phase 2 Data Migration Script
 *
 * This script migrates existing data to the new Phase 2 schema:
 * 1. Migrates Story.characters JSON to StoryCharacter table
 * 2. Migrates Panel.character_name to Panel.character_id
 * 3. Copies Character.base_image_url to Character.reference_image
 *
 * Run with: npx ts-node scripts/migrate-phase2-data.ts
 * Or: npx tsx scripts/migrate-phase2-data.ts
 */

import { PrismaClient, Prisma } from "@prisma/client";

const prisma = new PrismaClient();

interface LegacyCharacter {
  name: string;
  role?: string;
  description?: string;
  arc?: string;
}

/**
 * Map Chinese/English role names to standard values
 */
function mapRole(role?: string): string {
  if (!role) return "supporting";

  const roleMap: Record<string, string> = {
    // Chinese
    "主角": "protagonist",
    "反派": "antagonist",
    "配角": "supporting",
    "龙套": "minor",
    "主人公": "protagonist",
    "敌人": "antagonist",
    // English
    protagonist: "protagonist",
    antagonist: "antagonist",
    supporting: "supporting",
    minor: "minor",
    main: "protagonist",
    villain: "antagonist",
    side: "supporting",
  };

  const normalized = role.toLowerCase().trim();
  return roleMap[normalized] || roleMap[role] || "supporting";
}

